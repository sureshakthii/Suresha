<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- One launch colour (thunai_launch_bg = the splash colour) from the system splash until the web app has
             drawn: the window behind the WebView and the bars match the splash, so nothing flashes white or dark.
             Once the app is loaded, public/app.js (syncStatusBar) sets the status bar from the app's light/dark theme. -->
        <item name="android:windowBackground">@color/thunai_launch_bg</item>
        <item name="android:statusBarColor">@color/thunai_launch_bg</item>
        <item name="android:navigationBarColor">@color/thunai_launch_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <!-- System splash (Android 12+ natively, older versions via androidx core-splashscreen): the lamp mark (adaptive
         foreground only, no tile) on the launch colour. Same colour as SplashScreen.backgroundColor in
         capacitor.config.json and the legacy drawable*/splash.png images (npm run mobile:icons). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/thunai_launch_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/thunai_launch_bg</item>
        <item name="android:navigationBarColor">@color/thunai_launch_bg</item>
    </style>
</resources>