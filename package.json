  },
  "homepage": "https://github.com/sureshakthii/Suresha#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "astronomy-engine": "^2.1.19",
    "express": "^5.2.1",
    "nodemailer": "^10.0.12",
    "web-push": "^3.6.7"
  },
  "type": "module",
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.3",
