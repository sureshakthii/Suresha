{
  "name": "kaippesi-jothidar",
  "version": "1.0.0",
  "description": "Kaippesi Jothidar — AI South Indian astrology mobile app",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "icons": "node scripts/make-icons.mjs",
    "build:artifact": "node scripts/build-artifact.mjs",
    "mobile:prepare": "node mobile/prepare.mjs",
    "mobile:icons": "node mobile/make-native-icons.mjs",
    "mobile:android": "npm run mobile:prepare && npx cap sync android",
    "mobile:ios": "npm run mobile:prepare && npx cap sync ios",
    "mobile:open:android": "npx cap open android",
    "mobile:open:ios": "npx cap open ios"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sureshakthii/Suresha.git"
  },
