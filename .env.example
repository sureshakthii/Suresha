# Optional — without a key Ask Thunai answers only from reviewed templates (and says so).
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_TIMEOUT_MS=45000     # model call limit; on timeout a reviewed fallback is sent, never a partial draft
# AI_STRUCTURED=on        # request the JSON answer contract as structured output
# POLICY_MODEL_CLASSIFIER=off   # optional model classifier on top of the deterministic safety router
# POLICY_CLASSIFIER_TIMEOUT_MS=8000
# AI_EFFORT=low          # low | medium | high
# AI_FALLBACKS=on        # set to "off" to disable server-side refusal fallbacks
PORT=3000

# ---- Login ----
# Secret for hashing OTPs. REQUIRED in production (the server refuses to start without it).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# 1 = never send real SMS/email; the OTP is logged and returned as devCode. Outside production,
# dev mode also switches on automatically for any channel with no provider configured.
# AUTH_DEV_MODE=1
# Public base URL (https → cookies are marked Secure). Needed for Facebook login.
# PUBLIC_URL=https://thunai.example
# (also replaces https://thunai.example in the page's canonical / Open Graph share tags)
# SQLite file (default data/kaippesi.db; ":memory:" for throwaway)
# DB_PATH=data/kaippesi.db

# SMS OTP routing: +91 numbers use MSG91 when configured; every other country uses Twilio.
# Twilio alone covers all countries (India too); MSG91 alone covers India only.
# SMS OTP — Twilio (international)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550001111
# SMS OTP — MSG91 (India; a DLT-approved flow template with an ##otp## variable)
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# Email OTP — any SMTP server, e.g. smtps://user:pass@smtp.gmail.com:465
# SMTP_URL=
# MAIL_FROM="Thunai <no-reply@example.com>"

# Facebook login (redirect URI to register: ${PUBLIC_URL}/api/auth/facebook/callback)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Set to 1 when running behind a reverse proxy / load balancer (correct client IPs for rate limits)
# TRUST_PROXY=1

# Require sign-in before using the AI Jothidar (protects your API budget)
# AI_REQUIRE_LOGIN=1
# Max AI questions per IP per 10 minutes (default 40)
# AI_RATE_LIMIT=40
# Daily AI caps (SQLite-backed, survive restarts). GLOBAL = whole-site ceiling per day; 0/unset = no ceiling.
# Set GLOBAL to what your monthly Anthropic budget allows ÷ 30.
# AI_DAILY_LIMIT_GLOBAL=0
# AI_DAILY_LIMIT_USER=200     # per signed-in account
# AI_DAILY_LIMIT_ANON=100     # per signed-out visitor (by IP)
# AI_DAILY_LIMIT_IP=500       # per IP address, signed in or not
# Longest model answer in tokens (1024–32000, default 16000)
# AI_MAX_TOKENS=16000

# ---- Marketplace (pooja store, priests, service requests) ----
# Razorpay keys (Dashboard → Settings → API Keys). Without both, orders are saved as
# "awaiting_payment_setup" and no payment is taken.
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# Admin API token (sent as the x-admin-token header). Unset → admin endpoints return 503.
# Legacy single admin token (acts as role "owner"). Prefer ADMIN_TOKENS below.
# ADMIN_TOKEN=
# Named admins with roles (owner | finance | support | viewer); tokens ≥ 24 chars (production refuses shorter). Every admin change is audited.
# ADMIN_TOKENS=meena:finance:<long-random>,ravi:support:<long-random>
# Store: the shipped catalogue is a SAMPLE and checkout refuses it. Replace server/data/products.json
# with a real catalogue ("sample": false) to open the store. STORE_ALLOW_SAMPLE=1 is for dev/tests only.
# STORE_ALLOW_SAMPLE=1
# Indicative Annadhanam cost in rupees per meal; unset → no amount is shown.
# ANNADHANAM_RATE=60

# ---- Weather & reminders (Web Push) ----
# VAPID keys for push notifications. Generate with: npx web-push generate-vapid-keys
# If unset, a pair is generated once and saved to data/vapid.json (fine for dev; set these in production,
# since changing keys invalidates every existing subscription).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https: URL). Default: PUBLIC_URL when it is https.
# VAPID_SUBJECT=mailto:support@your-domain

# ---- Subscriptions (Premium / Family plans) ----
# Exactly three payment currencies, from the person's country of residence (shared/currency.js):
# India → INR via the Razorpay keys above; United Arab Emirates → AED and every other country → USD via Stripe Checkout:
# STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# Signing secret of the webhook endpoint ${PUBLIC_URL}/api/billing/stripe/webhook
# (events: checkout.session.completed, charge.refunded). Without it the webhook returns 503.
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# Without a gateway for the chosen currency, checkout returns "payment_setup_pending".
# 1 = enforce the free AI quota (HTTP 402 once used up). Off by default.
# BILLING_ENFORCE=1
# Free Jothidar answers per person (or per IP when signed out) per day, India time (default 5)
# AI_FREE_DAILY=5

# ---- Growth (trials, referrals) ----
# Automatic free trial: hours of Premium given once to a signed-in user with no prior subscription
# (on their first GET /api/billing/me). Unset → no automatic trial. Gift codes work regardless.
# TRIAL_HOURS=24
# Premium days given to both the new user and the referrer on a referral claim (default 7).
# REFERRAL_DAYS=7

# ---- Razorpay webhook (source of truth for payments) ----
# Dashboard → Webhooks → ${PUBLIC_URL}/api/billing/razorpay/webhook, events: payment.captured, order.paid,
# payment.failed, refund.processed. Duplicate deliveries are ignored (x-razorpay-event-id).
# RAZORPAY_WEBHOOK_SECRET=

# ---- Prices (INITIAL TEST PRICES; defaults shown) ----
# PRICE_INR_PREMIUM_MONTH=199
# PRICE_INR_PREMIUM_YEAR=1999
# PRICE_INR_FAMILY_MONTH=399
# PRICE_INR_FAMILY_YEAR=3999
# PRICE_USD_PREMIUM_MONTH=4.99
# PRICE_USD_PREMIUM_YEAR=49
# PRICE_USD_FAMILY_MONTH=9.99
# PRICE_USD_FAMILY_YEAR=99
# PRICE_AED_PERSONAL_MONTH=18
# PRICE_AED_PERSONAL_YEAR=179
# PRICE_AED_FAMILY_MONTH=36
# PRICE_AED_FAMILY_YEAR=359
# One-time packages (rupees / dirhams / dollars)
# PRICE_INR_MARRIAGE_PACKAGE=499
# PRICE_AED_MARRIAGE_PACKAGE=33
# PRICE_USD_MARRIAGE_PACKAGE=9
# PRICE_INR_JOURNEY_PACKAGE=299
# PRICE_AED_JOURNEY_PACKAGE=22
# PRICE_USD_JOURNEY_PACKAGE=6
# Monthly AI-written answers included (never "unlimited" until costs are measured)
# AI_PREMIUM_MONTHLY=100
# AI_FAMILY_MONTHLY=250

# ---- Metrics (owner dashboard) ----
# Your AI provider's current price in ₹ per million tokens (input / output). Unset → cost shown as "not set".
# AI_COST_INR_PER_MTOK_IN=
# AI_COST_INR_PER_MTOK_OUT=
# Marketing spend in the last 30 days (₹), for acquisition cost
# MARKETING_SPEND_INR_30D=
# Gateway fee percentage used in contribution margin (default 2)
# GATEWAY_FEE_PCT=2

# ---- Rate limits (per instance, in memory) ----
# RATE_LIMITS=off            # disable (tests only)
# RATE_READ_PER_MIN=120
# RATE_WRITE_PER_10MIN=30
# Anonymous writes (feedback, push subscribe/test, priest registration) per IP per 10 minutes
# RATE_ANON_WRITE_PER_10MIN=60

# ---- HTTPS & browser security headers (server/security.js, docs/SECURITY-REVIEW.md) ----
# 1 = redirect plain-HTTP page loads to https (308) and refuse plain-HTTP API calls. Needs TRUST_PROXY behind a proxy.
# FORCE_HTTPS=1
# Strict-Transport-Security max-age in seconds (default 15552000 = 180 days). Sent only on HTTPS requests.
# HSTS_MAX_AGE=15552000
# Content-Security-Policy: (unset) = enforce · report-only = staged roll-out · off = emergency switch only
# CSP_MODE=
# Extra https origins the page may call (space separated), e.g. a CDN or analytics endpoint
# CSP_CONNECT_EXTRA=https://api.example.org
# Extra origins allowed to make state-changing /api calls (comma or space separated). PUBLIC_URL is always allowed.
# ALLOWED_ORIGINS=https://www.thunai.example

# ---- Automatic backups (server) ----
# Directory for scheduled SQLite backups (verified after each run). Copy it off the server as well.
# BACKUP_DIR=/var/data/backups
# BACKUP_EVERY_HOURS=24
# BACKUP_KEEP=14
# AES-256-GCM encryption of backups: 64 hex characters (openssl rand -hex 32). Keep it in the secret store, NOT next
# to the backups — without it an encrypted backup cannot be restored.
# BACKUP_ENCRYPTION_KEY=
